rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    function ownsRestaurant(restaurantId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.owner_id == request.auth.uid;
    }

    function ownsActiveRestaurant(restaurantId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.owner_id == request.auth.uid &&
        get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.status == 'active';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'owner' &&
        request.resource.data.account_status == 'active' &&
        request.resource.data.payment_status == 'unpaid' &&
        request.resource.data.trial_hours == 72 &&
        request.resource.data.subscription_hours == 72 &&
        request.resource.data.trial_days == 3 &&
        request.resource.data.subscription_days == 3;
      allow update: if isSuperAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'account_status', 'requested_business_name', 'rejection_reason',
          'payment_status', 'amount_paid', 'payment_note', 'created_at',
          'subscription_start', 'subscription_end', 'subscription_days', 'subscription_hours',
          'subscription_months', 'trial_days', 'trial_hours', 'last_renewed_at'
        ])
      );
      allow delete: if false;
    }

    match /restaurants/{restaurantId} {
      allow read: if resource.data.status == 'active' ||
        (isSignedIn() && resource.data.owner_id == request.auth.uid) ||
        isSuperAdmin();

      allow create: if isSuperAdmin() || (
        isSignedIn() &&
        request.resource.data.owner_id == request.auth.uid &&
        request.resource.data.status == 'active' &&
        request.resource.data.payment_status == 'unpaid' &&
        request.resource.data.trial_hours == 72 &&
        request.resource.data.subscription_hours == 72 &&
        request.resource.data.trial_days == 3 &&
        request.resource.data.subscription_days == 3
      );

      allow update: if isSuperAdmin() || (
        isSignedIn() &&
        resource.data.owner_id == request.auth.uid &&
        resource.data.status == 'active' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'owner_id', 'status', 'payment_status', 'amount_paid', 'payment_note',
          'managed_by_admin', 'client_name', 'client_contact', 'registration_source',
          'subscription_start', 'subscription_end', 'subscription_days', 'subscription_hours',
          'subscription_months', 'trial_days', 'trial_hours', 'last_renewed_at', 'show_on_home'
        ])
      );
      allow delete: if isSuperAdmin();

      match /branches/{docId} {
        allow read: if true;
        allow write: if ownsActiveRestaurant(restaurantId) || isSuperAdmin();
      }

      match /categories/{docId} {
        allow read: if true;
        allow create: if isSuperAdmin() || (ownsActiveRestaurant(restaurantId) && request.resource.data.owner_id == request.auth.uid);
        allow update, delete: if isSuperAdmin() || (ownsActiveRestaurant(restaurantId) && resource.data.owner_id == request.auth.uid);
      }

      match /products/{docId} {
        allow read: if true;
        allow create: if isSuperAdmin() || (ownsActiveRestaurant(restaurantId) && request.resource.data.owner_id == request.auth.uid);
        allow update, delete: if isSuperAdmin() || (ownsActiveRestaurant(restaurantId) && resource.data.owner_id == request.auth.uid);
      }

      match /offers/{docId} {
        allow read: if true;
        allow create: if isSuperAdmin() || (ownsActiveRestaurant(restaurantId) && request.resource.data.owner_id == request.auth.uid);
        allow update, delete: if isSuperAdmin() || (ownsActiveRestaurant(restaurantId) && resource.data.owner_id == request.auth.uid);
      }

      match /coupons/{docId} {
        allow read: if true;
        allow create: if isSuperAdmin() || (ownsActiveRestaurant(restaurantId) && request.resource.data.owner_id == request.auth.uid);
        allow update, delete: if isSuperAdmin() || (ownsActiveRestaurant(restaurantId) && resource.data.owner_id == request.auth.uid);
      }

      match /reviews/{docId} {
        allow read: if true;
        allow create: if true;
        allow update: if false;
        allow delete: if ownsActiveRestaurant(restaurantId) || isSuperAdmin();
      }

      match /orders/{docId} {
        allow create: if true;
        allow read, update: if ownsActiveRestaurant(restaurantId) || isSuperAdmin();
        allow delete: if isSuperAdmin();
      }

      match /order_status/{docId} {
        allow read: if true;
        allow create: if true;
        allow update: if ownsActiveRestaurant(restaurantId) || isSuperAdmin();
        allow delete: if isSuperAdmin();
      }

      match /qrcodes/{docId} {
        allow read: if true;
        allow create: if isSuperAdmin() || (ownsActiveRestaurant(restaurantId) && request.resource.data.owner_id == request.auth.uid);
        allow update, delete: if isSuperAdmin() || (ownsActiveRestaurant(restaurantId) && resource.data.owner_id == request.auth.uid);
      }

      match /visits/{docId} {
        allow create: if true;
        allow read: if ownsActiveRestaurant(restaurantId) || isSuperAdmin();
        allow update, delete: if false;
      }

      match /subscriptions/{docId} {
        allow read: if ownsRestaurant(restaurantId) || isSuperAdmin();
        allow create: if isSignedIn() && (request.resource.data.owner_id == request.auth.uid || isSuperAdmin());
        allow update, delete: if isSuperAdmin();
      }

      match /payments/{docId} {
        allow read: if ownsRestaurant(restaurantId) || isSuperAdmin();
        allow write: if isSuperAdmin();
      }
    }

    match /business_types/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /catalog_products/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /catalog_suggestions/{docId} {
      allow create: if isSignedIn() && request.resource.data.owner_id == request.auth.uid;
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.owner_id == request.auth.uid);
      allow update, delete: if isSuperAdmin();
    }

    match /plans/{planCode} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /languages/{code} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /platform_settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /activity_logs/{docId} {
      allow read: if isSuperAdmin() ||
        (isSignedIn() && ownsRestaurant(resource.data.restaurant_id));
      allow create: if isSignedIn() && request.resource.data.actor_id == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
